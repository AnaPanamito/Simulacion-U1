<?xml version='1.0' encoding='utf-8'?>
<model version="NetLogo 7.0.0" snapToGrid="true">
  <code>
extensions [csv]

breed [clientes cliente]
breed [servidores servidor]

globals [
  resumen serie indice escenario-actual
  tiempo-actual cola-actual ocupados-actual puestos-actual
]

; INICIAR prepara la vista y lee los CSV sin seleccionar archivos.
to iniciar-vista
  clear-all
  set resumen []
  set serie []
  set indice 0
  set escenario-actual 4
  set tiempo-actual 0
  set cola-actual 0
  set ocupados-actual 0
  set puestos-actual 0
  reset-ticks
  cargar-datos
end

; Busca de forma automatica archivos junto al proyecto, sin user-file.
; El modelo .nlogox esta en NetLogo/ y los CSV en Resultados/.
to-report buscar-archivo [nombre]
  let rutas (list
    (word "../Resultados/" nombre)
    (word "Resultados/" nombre)
    (word "./Resultados/" nombre)
    nombre)
  let encontrada false
  foreach rutas [ruta -&gt;
    if (encontrada = false) [
      if (file-exists? ruta) [ set encontrada ruta ]
    ]
  ]
  report encontrada
end

; Un solo boton vuelve a importar resumen y escenario inicial.
to cargar-datos
  let ruta (buscar-archivo "netlogo_escenarios.csv")
  if (ruta = false) [
    user-message (word
      "No encuentro Resultados/netlogo_escenarios.csv. "
      "Descomprima el ZIP completo, manteniendo NetLogo/ y Resultados/ "
      "al mismo nivel; luego ejecute python main.py si faltan los CSV.")
    stop
  ]
  let datos csv:from-file ruta
  if (empty? datos) [
    user-message "El CSV de escenarios esta vacio."
    stop
  ]
  if ((item 0 (first datos)) != "c") [
    user-message "Encabezado invalido en netlogo_escenarios.csv."
    stop
  ]
  set resumen but-first datos
  graficar-resumen
  cargar-escenario 4
end

; Los botones 3/4/5/6 llaman a este procedimiento.
to cargar-escenario [numero]
  let nombre (word "netlogo_serie_c" numero ".csv")
  let ruta (buscar-archivo nombre)
  if (ruta = false) [
    user-message (word "No se encontro Resultados/" nombre ". "
                       "Ejecute python main.py para generarlo.")
    stop
  ]
  let datos csv:from-file ruta
  if (empty? datos) [
    user-message (word "Archivo vacio: " nombre)
    stop
  ]
  if ((item 0 (first datos)) != "tiempo_min") [
    user-message (word "Encabezado invalido en " nombre)
    stop
  ]
  set escenario-actual numero
  set serie but-first datos
  reiniciar-reproduccion
  if (not empty? serie) [ paso ]
end

to graficar-resumen
  set-current-plot "Comparacion Wq"
  clear-plot
  foreach resumen [fila -&gt;
    if ((length fila &gt;= 8) and ((item 6 fila) = "si")) [
      let cs item 0 fila
      if (is-number? cs) [
        if (is-number? (item 1 fila)) [
          set-current-plot-pen "Teorico"
          plotxy cs (item 1 fila)
        ]
        if (is-number? (item 2 fila)) [
          set-current-plot-pen "Simulado"
          plotxy cs (item 2 fila)
        ]
      ]
    ]
  ]
end

to paso
  if (empty? serie) [
    user-message "Primero pulse INICIAR o CARGAR DATOS."
    stop
  ]
  if (indice &gt;= length serie) [stop]
  let fila item indice serie
  if (length fila &lt; 4) [
    user-message "Fila invalida. CSV esperado: tiempo_min,cola,ocupados,puestos."
    stop
  ]
  set tiempo-actual item 0 fila
  set cola-actual item 1 fila
  set ocupados-actual item 2 fila
  set puestos-actual item 3 fila
  if ((not (is-number? tiempo-actual)) or (not (is-number? cola-actual)) or
      (not (is-number? ocupados-actual)) or (not (is-number? puestos-actual))) [
    user-message "El CSV contiene valores no numericos."
    stop
  ]
  actualizar-agentes
  set-current-plot "Evolucion de la cola"
  set-current-plot-pen "En cola"
  plotxy tiempo-actual cola-actual
  set-current-plot-pen "En atencion"
  plotxy tiempo-actual ocupados-actual
  set indice indice + 1
  tick
end

to animar
  if indice &gt;= length serie [stop]
  paso
end

to reiniciar-reproduccion
  set indice 0
  set tiempo-actual 0
  set cola-actual 0
  set ocupados-actual 0
  set puestos-actual escenario-actual
  ask turtles [ die ]
  set-current-plot "Evolucion de la cola"
  clear-plot
  reset-ticks
  actualizar-agentes
end

; Los puestos ahora aparecen SEPARADOS en una o dos filas.
; Verde = ocupado, azul = libre; naranja = personas esperando.
to actualizar-agentes
  ask turtles [ die ]
  let i 0
  let visibles floor (min (list 12 puestos-actual))
  repeat visibles [
    let posicion i
    create-servidores 1 [
      set shape "square"
      set color blue
      if (posicion &lt; ocupados-actual) [set color green]
      set size 2.1
      setxy (-11 + (posicion mod 6) * 4.2) (-5 - (floor (posicion / 6)) * 4)
    ]
    set i i + 1
  ]
  ; Colorea siempre los primeros puestos ocupados: representacion determinista.
  let j 0
  let en-vista floor (min (list 28 cola-actual))
  repeat en-vista [
    let posicion j
    create-clientes 1 [
      set shape "person"
      set color orange
      set size 1.5
      setxy (-11 + (posicion mod 6) * 3.8) (9 - (floor (posicion / 6)) * 2.3)
    ]
    set j j + 1
  ]
end

to guardar-vista
  let ruta user-new-file
  if (ruta = false) [stop]
  export-interface ruta
end

</code>
  <widgets>
    <view x="20" y="156" width="443" height="337" minPxcor="-16" maxPxcor="16" minPycor="-12" maxPycor="12" patchSize="12.0" wrappingAllowedX="false" wrappingAllowedY="false" fontSize="12" updateMode="1" showTickCounter="true" frameRate="30.0" tickCounterLabel="ticks"></view>
    <note x="20" y="10" width="910" height="32" fontSize="16" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0" markdown="false">BIBLIOTECA UNIVERSITARIA M/M/c | Datos calculados en Python | NetLogo 7</note>
    <monitor x="474" y="168" width="112" height="52" precision="2" fontSize="11" display="Minuto" sizeVersion="0">tiempo-actual</monitor>
    <monitor x="593" y="168" width="112" height="52" precision="2" fontSize="11" display="En cola" sizeVersion="0">cola-actual</monitor>
